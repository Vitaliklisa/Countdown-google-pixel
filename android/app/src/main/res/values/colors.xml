<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand colors for the native shell, mirroring src/styles.css:
    canvas #0b0b0a · fg #f3f1ea · accent #6fd0b6
  Capacitor's own styles.xml references @color/colorPrimary etc., so these names
  must exist here even though the WebView paints the actual UI.
-->
<resources>
    <color name="colorPrimary">#0b0b0a</color>
    <color name="colorPrimaryDark">#0b0b0a</color>
    <color name="colorAccent">#6fd0b6</color>
</resources>
